# Copy to .env and fill in. Never commit .env.

PORT=3000

# Google Sheet ID: the long id in https://docs.google.com/spreadsheets/d/<SHEET_ID>/edit
# The sheet must be shared as "Anyone with the link: Viewer" (or File > Share > Publish to web).
SHEET_ID=

# Tabs are found by name (defaults match the "YG Trades Report" sheet: 5X, Gold Indicator, BTC Indicator).
# Only set these if you rename a tab. Set to - to skip a channel.
# SHEET_TAB_5X=5X
# SHEET_TAB_GOLD=Gold Indicator
# SHEET_TAB_BTC=BTC Indicator

# Optional, more exact: the gid of a tab (number after #gid= in the URL). A gid wins over the tab name.
SHEET_GID_5X=
SHEET_GID_GOLD=
SHEET_GID_BTC=

# How dates are written in the sheet when they use slashes: MDY (11/2/2026) or DMY (2/11/2026).
DATE_FORMAT=MDY
# Year used when a date has no year (e.g. "11/2").
DEFAULT_YEAR=2026

# Sync interval in minutes.
SYNC_INTERVAL_MIN=15

# SQLite file location.
DB_FILE=data/trades.db

# Optional: enables POST /api/sync with header "x-sync-token: <value>". Leave empty to disable.
SYNC_TOKEN=
